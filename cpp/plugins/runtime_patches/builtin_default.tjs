// ==========================================================================
// krkr2 Android — built-in runtime compatibility patch
//
// This script is auto-injected before patch.tjs at every startup. It is
// the "default" stage of the compat framework.
//
// Most fallbacks are now handled in C++ (see
// cpp/plugins/voiceEffectPluginCompat.cpp etc.) because TJS-side
// definitions are subtle and brittle — TJS lookups fall back from `this`
// to `global`, and the `kag` instance only exists after KAGWindow's
// constructor runs.
//
// This file is intentionally tiny. Add high-level, opt-in *script*
// fallbacks here when they help across many games. For per-game tweaks
// drop a script into `<gamedir>/compat/*.tjs` instead.
// ==========================================================================

if(typeof global.__krkr2_runtimePatchApplied == "undefined") {
    global.__krkr2_runtimePatchApplied = true;

    // Some patch scripts touch these namespaces before the native plugin
    // registration phase finishes. Create the containers early so scripts
    // like patch.tjs can at least resolve them safely.
    global.Motion = global.Motion === void ? %[] : global.Motion;
    global.ENV_context = global.ENV_context === void ? %[] : global.ENV_context;

    // ---------------------------------------------------------------
    // Window / meswinload compatibility for yuzu / wamsoft titles.
    //
    // Important: many scripts call these as FREE IDENTIFIERS inside a
    // KAGWindow method body, not as `window.foo()`. In TJS that means the
    // resolver may walk `this -> global`. Therefore patch BOTH the Window
    // prototype and global functions.
    // ---------------------------------------------------------------
    (function() {
        function _getCompatKag() {
            if(global.kag) return global.kag;
            if(global.mainWindow && global.mainWindow.kag) return global.mainWindow.kag;
            return void 0;
        }
        function _getCompatWidth() {
            var k = _getCompatKag();
            if(k && k.fore && k.fore.layers && k.fore.layers[0])
                return k.fore.layers[0].width;
            return 1920;
        }
        function _getCompatHeight() {
            var k = _getCompatKag();
            if(k && k.fore && k.fore.layers && k.fore.layers[0])
                return k.fore.layers[0].height;
            return 1080;
        }
        function _noop() {}

        var proto = Window.prototype;
        if(typeof proto.getWindowVirtualPixelHeight === "undefined")
            proto.getWindowVirtualPixelHeight = function() { return _getCompatHeight(); };
        if(typeof proto.getWindowVirtualPixelWidth === "undefined")
            proto.getWindowVirtualPixelWidth = function() { return _getCompatWidth(); };
        if(typeof proto.currentSquareMode === "undefined") {
            Object.defineProperty(proto, "currentSquareMode", {
                get: function() { return false; },
                set: function(v) {},
                enumerable: false
            });
        }
        if(typeof proto.getSquareModeDiff === "undefined")
            proto.getSquareModeDiff = function() { return 0; };
        if(typeof proto.onWindowPxHeightChanged === "undefined")
            proto.onWindowPxHeightChanged = %[];

        if(typeof global.getWindowVirtualPixelHeight === "undefined")
            global.getWindowVirtualPixelHeight = _getCompatHeight;
        if(typeof global.getWindowVirtualPixelWidth === "undefined")
            global.getWindowVirtualPixelWidth = _getCompatWidth;
        if(typeof global.currentSquareMode === "undefined")
            global.currentSquareMode = false;
        if(typeof global.getSquareModeDiff === "undefined")
            global.getSquareModeDiff = function() { return 0; };
        if(typeof global.onWindowPxHeightChanged === "undefined")
            global.onWindowPxHeightChanged = %[];

        // Also attach to the shared compatibility namespace early.
        if(typeof global.Krkr2CompatUtils === "undefined")
            global.Krkr2CompatUtils = %[];
        if(typeof global.Krkr2CompatUtils.getWindowVirtualPixelHeight === "undefined")
            global.Krkr2CompatUtils.getWindowVirtualPixelHeight = _getCompatHeight;
        if(typeof global.Krkr2CompatUtils.getWindowVirtualPixelWidth === "undefined")
            global.Krkr2CompatUtils.getWindowVirtualPixelWidth = _getCompatWidth;
        if(typeof global.Krkr2CompatUtils.getSquareModeDiff === "undefined")
            global.Krkr2CompatUtils.getSquareModeDiff = function() { return 0; };

    })();
}
