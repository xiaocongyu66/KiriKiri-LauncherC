// ==========================================================================
// krkr2 Android — built-in runtime compatibility patch
//
// This script is auto-injected before patch.tjs at every startup. It is
// the "default" stage of the compat framework.
//
// Most fallbacks are now handled in C++ (see
// cpp/plugins/voiceEffectPluginCompat.cpp etc.) because TJS-side
// definitions are subtle and brittle — TJS lookups fall back from `this`
// to `global`, and the `kag` instance only exists after KAGWindow's
// constructor runs.
//
// This file is intentionally tiny. Add high-level, opt-in *script*
// fallbacks here when they help across many games. For per-game tweaks
// drop a script into `<gamedir>/compat/*.tjs` instead.
// ==========================================================================

function __krkr2_isString(value=void) {
    var type = typeof value;
    return type == "string" || type == "String";
}

function __krkr2_hasGlobal(name=void) {
    try {
        return __krkr2_isString(name) && typeof global[name] != "undefined";
    } catch(e) {
        return false;
    }
}

// Win32 dialog result constants used by several commercial titles. Keep these
// outside the one-shot guard because some games execute their own patch stages
// before this file and may partially initialize the runtime marker.
if(typeof global.IDOK == "undefined") global.IDOK = 1;
if(typeof global.IDCANCEL == "undefined") global.IDCANCEL = 2;
if(typeof global.IDABORT == "undefined") global.IDABORT = 3;
if(typeof global.IDRETRY == "undefined") global.IDRETRY = 4;
if(typeof global.IDIGNORE == "undefined") global.IDIGNORE = 5;
if(typeof global.IDYES == "undefined") global.IDYES = 6;
if(typeof global.IDNO == "undefined") global.IDNO = 7;
if(typeof global.IDCLOSE == "undefined") global.IDCLOSE = 8;

if(typeof global.__krkr2_runtimePatchApplied == "undefined" ||
   !global.__krkr2_runtimePatchApplied) {
    global.__krkr2_runtimePatchApplied = true;

    // Some patch scripts touch this namespace before the relevant game
    // scripts create it. Do not pre-create Motion here: the native
    // motionplayer.dll plugin owns that namespace.
    if(typeof global.ENV_context == "undefined")
        global.ENV_context = %[];

    // PackinOne / append-data compatibility. Several KAG3 titles probe these
    // helpers during early config loading even when the real plugin is not
    // linked yet. Return benign defaults and let real game/plugin definitions
    // win whenever they exist.
    if(typeof global.makeDataPackDigest == "undefined") {
        function __krkr2_makeDataPackDigest(a=void, b=void, c=void, d=void) {
            return "";
        }
        global.makeDataPackDigest = __krkr2_makeDataPackDigest;
    }

    if(typeof global.AppendDataConfig == "undefined") {
        var __krkr2_appendDataConfig = %[
            "min" => void,
            "max" => void,
            "archive" => void
        ];
        __krkr2_appendDataConfig.load = function(a=void, b=void, c=void) { return false; };
        __krkr2_appendDataConfig.save = function(a=void, b=void, c=void) { return false; };
        __krkr2_appendDataConfig.add = function(a=void, b=void, c=void) { return void; };
        __krkr2_appendDataConfig.clear = function() { return void; };
        global.AppendDataConfig = __krkr2_appendDataConfig;
    }

    function __krkr2_isAsciiScalePrefix(text=void, colonPos=void) {
        if(!__krkr2_isString(text))
            return false;
        if(colonPos === void)
            colonPos = text.indexOf("：");
        if(colonPos <= 0)
            return false;

        var digits = "0123456789";
        var dotSeen = false;
        for(var i = 0; i < colonPos; i++) {
            var ch = text.charAt(i);
            if(ch == ".") {
                if(dotSeen)
                    return false;
                dotSeen = true;
                continue;
            }
            if(digits.indexOf(ch) < 0)
                return false;
        }
        return true;
    }

    function __krkr2_normalizeIndexedResourceCell(text=void) {
        if(!__krkr2_isString(text))
            return text;
        var colonPos = text.indexOf("：");
        if(colonPos <= 0)
            return text;
        if(!__krkr2_isAsciiScalePrefix(text, colonPos))
            return text;
        return text.substr(0, colonPos) + ":" + text.substr(colonPos + 1);
    }

    function __krkr2_stripIndexedResourceScalePrefix(text=void) {
        if(!__krkr2_isString(text))
            return text;

        var colonPos = text.indexOf(":");
        var wideColonPos = text.indexOf("：");
        if(colonPos < 0 || (wideColonPos >= 0 && wideColonPos < colonPos))
            colonPos = wideColonPos;
        if(colonPos <= 0)
            return text;
        if(!__krkr2_isAsciiScalePrefix(text, colonPos))
            return text;
        return text.substr(colonPos + 1);
    }

    function __krkr2_registerResourceAlias(alias=void, target=void) {
        try {
            if(!__krkr2_isString(alias) || !__krkr2_isString(target))
                return;
            alias = __krkr2_stripIndexedResourceScalePrefix(alias);
            target = __krkr2_stripIndexedResourceScalePrefix(target);
            if(alias == "" || target == "" || alias == target)
                return;

            if(!__krkr2_hasGlobal("Storages") ||
               typeof global.Storages.registerResourceAlias == "undefined")
                return;
            global.Storages.registerResourceAlias(alias, target);
        } catch(e) {}
    }

    function __krkr2_storageFileNameLower(storage=void) {
        try {
            if(!__krkr2_isString(storage))
                return "";
            if(__krkr2_hasGlobal("Storages") &&
               typeof global.Storages.extractStorageName != "undefined")
                storage = global.Storages.extractStorageName(storage);
            return storage.toLowerCase();
        } catch(e) {
            return "";
        }
    }

    function __krkr2_registerIndexedResourceAliases(storage=void, rows=void) {
        try {
            if(rows === void || typeof rows.count == "undefined")
                return;

            var file = __krkr2_storageFileNameLower(storage);
            var isMulti = file.indexOf("imagemulti") >= 0;
            var isNameMap = file.indexOf("imagenamemap") >= 0;
            var isDiffMap = file.indexOf("imagediffmap") >= 0;
            if(!isMulti && !isNameMap && !isDiffMap)
                return;

            for(var i = 0; i < rows.count; i++) {
                var row = rows[i];
                if(row === void || typeof row.count == "undefined" ||
                   row.count < 2)
                    continue;
                var alias = row[0];
                if(!__krkr2_isString(alias) || alias == "" ||
                   alias.substr(0, 1) == "#")
                    continue;

                if(isMulti) {
                    for(var j = 1; j < row.count; j++)
                        __krkr2_registerResourceAlias(alias, row[j]);
                } else {
                    __krkr2_registerResourceAlias(alias, row[1]);
                }
            }
        } catch(e) {}
    }

    function __krkr2_installIndexedResourceConfigCompat() {
        if(typeof global.__krkr2_indexedResourceConfigCompatApplied != "undefined" &&
           global.__krkr2_indexedResourceConfigCompatApplied)
            return;
        if(typeof global.loadConfigFile == "undefined")
            return;

        global.__krkr2_indexedResourceConfigCompatApplied = true;
        global.__krkr2_loadConfigFile_indexedResourceCompat = global.loadConfigFile;
        global.loadConfigFile = function(marker=void, storage=void, delim=void) {
            var rows = global.__krkr2_loadConfigFile_indexedResourceCompat(*);
            try {
                if(rows !== void && typeof rows.count != "undefined") {
                    for(var i = 0; i < rows.count; i++) {
                        var row = rows[i];
                        if(row === void || typeof row.count == "undefined")
                            continue;
                        for(var j = 0; j < row.count; j++) {
                            var normalized =
                                __krkr2_normalizeIndexedResourceCell(row[j]);
                            if(normalized !== row[j])
                                row[j] = normalized;
                        }
                    }
                }
                __krkr2_registerIndexedResourceAliases(storage, rows);
            } catch(e) {}
            return rows;
        };
    }

    function __krkr2_tryInstallIndexedResourceCompat() {
        try {
            __krkr2_installIndexedResourceConfigCompat();
        } catch(e) {}
    }

    __krkr2_tryInstallIndexedResourceCompat();

    if(__krkr2_hasGlobal("Scripts") &&
       typeof global.Scripts.execStorage != "undefined" &&
       typeof global.Scripts.__krkr2_indexedResourceCompatExecStorage == "undefined") {
        global.Scripts.__krkr2_indexedResourceCompatExecStorage =
            global.Scripts.execStorage;
        global.Scripts.execStorage = function(name=void) {
            var ret =
                global.Scripts.__krkr2_indexedResourceCompatExecStorage(*);
            __krkr2_tryInstallIndexedResourceCompat();
            return ret;
        };
    }
}
