// ==========================================================================
// krkr2 Android — built-in runtime compatibility patch
//
// This script is auto-injected before patch.tjs at every startup. It is
// the "default" stage of the compat framework.
//
// Most fallbacks are now handled in C++ (see
// cpp/plugins/voiceEffectPluginCompat.cpp etc.) because TJS-side
// definitions are subtle and brittle — TJS lookups fall back from `this`
// to `global`, and the `kag` instance only exists after KAGWindow's
// constructor runs.
//
// This file is intentionally tiny. Add high-level, opt-in *script*
// fallbacks here when they help across many games. For per-game tweaks
// drop a script into `<gamedir>/compat/*.tjs` instead.
// ==========================================================================

if(typeof global.__krkr2_runtimePatchApplied == "undefined") {
    global.__krkr2_runtimePatchApplied = true;

    // Some patch scripts touch this namespace before the relevant game
    // scripts create it. Do not pre-create Motion here: the native
    // motionplayer.dll plugin owns that namespace.
    global.ENV_context = global.ENV_context === void ? %[] : global.ENV_context;

    // PackinOne / append-data compatibility. Several KAG3 titles probe these
    // helpers during early config loading even when the real plugin is not
    // linked yet. Return benign defaults and let real game/plugin definitions
    // win whenever they exist.
    if(typeof global.makeDataPackDigest == "undefined") {
        function __krkr2_makeDataPackDigest(a=void, b=void, c=void, d=void) {
            return "";
        }
        global.makeDataPackDigest = __krkr2_makeDataPackDigest;
    }

    if(typeof global.AppendDataConfig == "undefined") {
        var __krkr2_appendDataConfig = %[
            "min" => void,
            "max" => void,
            "archive" => void
        ];
        __krkr2_appendDataConfig.load = function(a=void, b=void, c=void) { return false; };
        __krkr2_appendDataConfig.save = function(a=void, b=void, c=void) { return false; };
        __krkr2_appendDataConfig.add = function(a=void, b=void, c=void) { return void; };
        __krkr2_appendDataConfig.clear = function() { return void; };
        global.AppendDataConfig = __krkr2_appendDataConfig;
    }

    function __krkr2_isAsciiScalePrefix(text=void, colonPos=void) {
        if(typeof text != "string")
            return false;
        if(colonPos === void)
            colonPos = text.indexOf("：");
        if(colonPos <= 0)
            return false;

        var digits = "0123456789";
        var dotSeen = false;
        for(var i = 0; i < colonPos; i++) {
            var ch = text.charAt(i);
            if(ch == ".") {
                if(dotSeen)
                    return false;
                dotSeen = true;
                continue;
            }
            if(digits.indexOf(ch) < 0)
                return false;
        }
        return true;
    }

    function __krkr2_normalizeIndexedResourceCell(text=void) {
        if(typeof text != "string")
            return text;
        var colonPos = text.indexOf("：");
        if(colonPos <= 0)
            return text;
        if(!__krkr2_isAsciiScalePrefix(text, colonPos))
            return text;
        return text.substr(0, colonPos) + ":" + text.substr(colonPos + 1);
    }

    function __krkr2_installIndexedResourceConfigCompat() {
        if(global.__krkr2_indexedResourceConfigCompatApplied)
            return;
        if(typeof global.loadConfigFile != "function")
            return;

        global.__krkr2_indexedResourceConfigCompatApplied = true;
        global.__krkr2_loadConfigFile_indexedResourceCompat = global.loadConfigFile;
        global.loadConfigFile = function(marker=void, storage=void, delim=void) {
            var rows = global.__krkr2_loadConfigFile_indexedResourceCompat(*);
            try {
                if(rows !== void && typeof rows.count != "undefined") {
                    for(var i = 0; i < rows.count; i++) {
                        var row = rows[i];
                        if(row === void || typeof row.count == "undefined")
                            continue;
                        for(var j = 0; j < row.count; j++) {
                            var normalized =
                                __krkr2_normalizeIndexedResourceCell(row[j]);
                            if(normalized !== row[j])
                                row[j] = normalized;
                        }
                    }
                }
            } catch(e) {}
            return rows;
        };
    }

    function __krkr2_tryInstallIndexedResourceCompat() {
        try {
            __krkr2_installIndexedResourceConfigCompat();
        } catch(e) {}
    }

    __krkr2_tryInstallIndexedResourceCompat();

    if(typeof Scripts != "undefined" && typeof Scripts.execStorage == "function" &&
       typeof Scripts.__krkr2_indexedResourceCompatExecStorage == "undefined") {
        Scripts.__krkr2_indexedResourceCompatExecStorage = Scripts.execStorage;
        Scripts.execStorage = function(name=void) {
            var ret = Scripts.__krkr2_indexedResourceCompatExecStorage(*);
            __krkr2_tryInstallIndexedResourceCompat();
            return ret;
        };
    }
}
