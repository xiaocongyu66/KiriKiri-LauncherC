/**
 * 擬似コードによるマニュアル
 * @description 吉里吉里Z AlphaMovie プラグイン。
 *
 * アルファチャンネル付き動画コンテナ .amv (Alpha Movie) を再生し、各フレームを
 * 対象 Layer のメイン画像バッファへ直接（アルファ込みで）上書き描画します。
 *
 * 使用例:
 *   var mov = new AlphaMovie();
 *   mov.open("video/explosion.amv");
 *   mov.setPosition(100, 80);
 *   mov.loop = true;
 *   // 毎フレーム:
 *   var no = mov.showNextImage(layer);
 *
 * showNextImage は呼ぶ度に 1 フレーム進め、描画したフレーム番号を返します。
 * 末尾で loop=true なら先頭へ巻き戻します。loop=false かつ末尾なら末尾番号を
 * 返し続けます（setNextMovieFile 予約があれば次映像へ自動遷移）。
 * 各フレームはフレーム固有の矩形（left,top,width,height）だけを上書きするため、
 * 描かれない領域は前フレームの内容が Layer 上に保持されます。
 */
class AlphaMovie {

	/**
	 * コンストラクタ（引数なし）
	 */
	function AlphaMovie();

	/**
	 * amv を開く
	 * @param filename 対象ストレージ（.amv）
	 */
	function open(filename);

	/**
	 * デコード済みキューをクリアする（本実装は同期デコードのため no-op）
	 */
	function clear();

	/**
	 * 次フレームを対象 Layer へ描画する
	 * @param layer 描画先 Layer（hasImage であること）
	 * @return 描画したフレーム番号（整数）
	 */
	function showNextImage(layer);

	/**
	 * 再生中かどうかを返す
	 * @return true=再生中 / false=停止中
	 */
	function isPlaying();

	/**
	 * 再生を開始する（先頭フレームへ巻き戻し、再生状態にする）
	 */
	function play();

	/**
	 * 再生を停止する
	 */
	function stop();

	/**
	 * 表示位置（左上）を設定する
	 * @param x 表示位置 X
	 * @param y 表示位置 Y
	 */
	function setPosition(x, y);

	/**
	 * 次に再生する amv を予約する（現映像の終了で自動遷移）
	 * @param filename 次に再生する amv ストレージ
	 */
	function setNextMovieFile(filename);

	/** 全フレーム数（読み取り専用） */
	property numOfFrame { getter; }

	/** 現在のフレーム番号。設定するとその位置へシークする */
	property frame { getter; setter; }

	/** ループ再生するか */
	property loop { getter; setter; }

	/** 次映像（setNextMovieFile）のループ設定 */
	property nextLoop { getter; setter; }

	/** 先読みバッファ数（本実装は値の保持のみ、既定 5） */
	property preloadSamples { getter; setter; }

	/** 表示位置左（= setPosition の X） */
	property left { getter; setter; }

	/** 表示位置上（= setPosition の Y） */
	property top { getter; setter; }

	/** 映像の幅（読み取り専用） */
	property screenWidth { getter; }

	/** 映像の高さ（読み取り専用） */
	property screenHeight { getter; }

	/** FPS の分子。FPS = FPSScale / FPSRate（読み取り専用） */
	property FPSScale { getter; }

	/** FPS の分母。FPS = FPSScale / FPSRate（読み取り専用） */
	property FPSRate { getter; }
};
